# Copy these into Vercel → Project → Settings → Environment Variables.
# Do not commit a real .env file — these are secrets.

# Gmail address the enquiry form sends FROM (must be a real Gmail/Workspace inbox).
GMAIL_USER=

# A 16-character Gmail App Password for GMAIL_USER, NOT the account's login password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on that Google account).
GMAIL_APP_PASSWORD=

# Optional: where enquiries should be delivered, if different from GMAIL_USER.
# Defaults to GMAIL_USER when unset.
SCHOOL_RECEIVING_EMAIL=

# --- Admin panel (/admin.html) ---
# The login credentials for the ONE admin account. Pick your own values —
# these are not real credentials, just the names of the env vars to set.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# A long random string used to sign admin login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value logs every admin out.
ADMIN_SESSION_SECRET=

# Required for the admin panel's photo uploads and content storage (staff,
# gallery, popup events, schemes, fees). In the Vercel dashboard: Storage →
# Create Database → Blob → connect it to this project. Vercel adds this
# variable automatically once the store is connected — you don't type it in
# by hand.
BLOB_READ_WRITE_TOKEN=

# --- Enquiry storage (required for enquiries to be saved) ---
# A SEPARATE, PRIVATE Blob store for parents' enquiries, so their contact
# details are never publicly addressable. Vercel → Storage → Create → Blob →
# access: Private → connect to this project with the env var prefix BLOB_ENQUIRY and tick "Add a read-write token env var"
# (Vercel then creates BLOB_ENQUIRY_READ_WRITE_TOKEN). Use a different store
# for the Preview environment so tests never touch real enquiries.
BLOB_ENQUIRY_READ_WRITE_TOKEN=

# --- Spam protection (optional but recommended) ---
# Cloudflare Turnstile keys (dash.cloudflare.com → Turnstile → add site).
# Without them the form still works, but no confirmation email is ever sent
# to the address a visitor typed (prevents the form being used to spam people).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Shared rate limiting (optional but recommended) ---
# Vercel Marketplace → Upstash Redis (free tier) adds these. Without them the
# enquiry and login limits are counted per server instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Website assistant ("Ask AARK"). One key for Production and Preview.
ANTHROPIC_API_KEY=
